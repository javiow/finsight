{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/shell-guard.sh",
            "statusMessage": "위험 명령 검사"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/tdd-guard.sh",
            "statusMessage": "TDD Guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint && npm run build && npm run test"
          }
        ]
      }
    ]
  }
}

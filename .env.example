NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Oncall alert triage — POST /api/webhooks/posthog-alert
# PostHog 웹훅 destination의 커스텀 헤더(X-Webhook-Secret)와 동일한 값이어야 한다.
POSTHOG_ALERT_WEBHOOK_SECRET=
# repository_dispatch(event_type: posthog-alert)만 트리거할 수 있으면 되므로
# fine-grained PAT로 발급하고 Contents: write 권한만 준다. javiow/finsight 전용.
GITHUB_DISPATCH_TOKEN=
